---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import { scholarPapers } from '../../data/scholarPapers';

const sourceLabel = (paper: (typeof scholarPapers)[number]) => {
  const source = paper.venue
    .replace(/\s+\d.*$/, '')
    .replace(/,\s*$/, '')
    .trim();

  return source || 'Scholar';
};

type NumberedPaper = (typeof scholarPapers)[number] & {
  globalIndex: number;
  originalIndex: number;
};

const numberedPapers = [...scholarPapers]
  .map((paper, originalIndex) => ({ ...paper, originalIndex }))
  .sort((a, b) => a.year - b.year || b.originalIndex - a.originalIndex)
  .map((paper, index) => ({ ...paper, globalIndex: index + 1 }));

const papersByYear = numberedPapers.reduce<Record<number, NumberedPaper[]>>((groups, paper) => {
  groups[paper.year] ??= [];
  groups[paper.year].push(paper);
  return groups;
}, {});

Object.values(papersByYear).forEach((papers) => papers.sort((a, b) => a.originalIndex - b.originalIndex));

const years = Object.keys(papersByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout title="Papers" description="Papers and prior publications from the Autonomous Materials Discovery Group Cambridge.">
  <PageHeader
    title="Publications"
    description="Selected preprints and publications from the group, arranged by year."
  />
  <section class="section">
    <div class="container publication-page">
      <p class="scholar-link">
        <a href="https://scholar.google.co.uk/citations?user=e5fFIDkAAAAJ&hl=en">Google Scholar profile</a>
      </p>
      <div class="reference-list">
        {
          years.map((year) => (
            <section class="year-section" aria-labelledby={`papers-${year}`}>
              <h2 id={`papers-${year}`}>{year}</h2>
              <ol class="publication-list compact continuous">
                {
                  papersByYear[year].map((paper) => (
                    <li value={paper.globalIndex}>
                      &ldquo;{paper.title}&rdquo;{' '}
                      <a href={paper.doi ? `https://doi.org/${paper.doi}` : paper.scholarQuery}>
                        {sourceLabel(paper)} ({paper.year})
                      </a>
                    </li>
                  ))
                }
              </ol>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';

const gallery = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Gallery" description="Gallery and logo story from the Autonomous Materials Discovery Group Cambridge.">
  <PageHeader
    title="Gallery"
    description="Moments from the lab, events, and the visual story of the group."
  />
  <section class="section">
    <ul class="container gallery-wall">
      {
        gallery.map((item, index) => {
          const prevId = gallery[(index - 1 + gallery.length) % gallery.length].id;
          const nextId = gallery[(index + 1) % gallery.length].id;
          const imageAlt = item.data.imageAlt ?? item.data.caption;
          const dateMeta = item.data.date ? <p class="meta">{item.data.date}</p> : null;

          return (
            <li class={`gallery-card ${item.data.layout === 'full' ? 'gallery-card-full' : ''}`}>
              <div class="gallery-thumb">
                <a class="gallery-thumb-link" href={`#gallery-lightbox-${item.id}`} aria-label={`View ${item.data.title} fullscreen`} title={item.data.title}>
                  <img src={item.data.image} alt={imageAlt} loading="lazy" />
                </a>
              </div>
              <div id={`gallery-lightbox-${item.id}`} class="gallery-lightbox" role="dialog" aria-modal="true" aria-label={item.data.title}>
                <a class="gallery-lightbox-close" href="#" aria-label="Close fullscreen view">×</a>
                <nav class="gallery-lightbox-nav" aria-label="Gallery navigation">
                  <a class="gallery-lightbox-nav-button gallery-lightbox-prev" href={`#gallery-lightbox-${prevId}`} aria-label="Previous image">←</a>
                  <a class="gallery-lightbox-nav-button gallery-lightbox-next" href={`#gallery-lightbox-${nextId}`} aria-label="Next image">→</a>
                </nav>
                <div class="gallery-lightbox-inner">
                  <img data-src={item.data.image} alt={imageAlt} />
                  <div class="gallery-lightbox-meta">
                    {dateMeta}
                    <h2>{item.data.title}</h2>
                    <p>{item.data.caption}</p>
                  </div>
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
  </section>
  <script type="module" src="/scripts/gallery-lightbox.js"></script>
</BaseLayout>

---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';

// Tiles are sized in CSS pixels by justified-gallery.js (rows target 260px tall, or
// full container width for `layout: full`), so each derivative is a fixed width chosen
// to cover that at 2x DPR rather than a srcset the layout script can't describe.
const THUMB_WIDTH = 900;
const THUMB_WIDTH_FULL = 1800;
const LIGHTBOX_WIDTH = 2200;

const rawGallery = (await getCollection('gallery')).sort((a, b) => a.data.order - b.data.order);

// Everything here is derived from getImage() results rather than read off
// item.data.image. Touching a property on the original metadata makes Astro emit the
// full-size original into dist/_astro even though nothing links to it — see
// https://github.com/withastro/astro/issues/11887. The derivative's own dimensions
// give the same aspect ratio, so the originals stay out of the build.
const gallery = await Promise.all(
  rawGallery.map(async (item) => {
    const isFull = item.data.layout === 'full';
    const [thumb, lightbox] = await Promise.all([
      getImage({
        src: item.data.image,
        width: isFull ? THUMB_WIDTH_FULL : THUMB_WIDTH,
        format: 'webp'
      }),
      getImage({ src: item.data.image, width: LIGHTBOX_WIDTH, format: 'webp' })
    ]);

    return {
      ...item,
      isFull,
      aspectRatio: Number(thumb.attributes.width) / Number(thumb.attributes.height),
      thumb,
      lightboxSrc: lightbox.src
    };
  })
);
---

<BaseLayout title="Gallery" description="Gallery and logo story from the Autonomous Materials Discovery Group Cambridge.">
  <PageHeader
    title="Gallery"
    description="Moments from the lab, events, and the visual story of the group."
  />
  <section class="section">
    <ul class="container gallery-wall" id="gallery-wall">
      {
        gallery.map((item, index) => {
          const prevId = gallery[(index - 1 + gallery.length) % gallery.length].id;
          const nextId = gallery[(index + 1) % gallery.length].id;
          const imageAlt = item.data.imageAlt ?? item.data.caption;
          const dateMeta = item.data.date ? <p class="meta">{item.data.date}</p> : null;

          return (
            <li
              class="gallery-card"
              data-ar={item.aspectRatio}
              data-full={item.isFull ? 'true' : 'false'}
            >
              <div class="gallery-thumb">
                <a class="gallery-thumb-link" href={`#gallery-lightbox-${item.id}`} aria-label={`View ${item.data.title} fullscreen`}>
                  <img
                    src={item.thumb.src}
                    width={item.thumb.attributes.width}
                    height={item.thumb.attributes.height}
                    alt={imageAlt}
                    loading="lazy"
                  />
                </a>
              </div>
              <div id={`gallery-lightbox-${item.id}`} class="gallery-lightbox" role="dialog" aria-modal="true" aria-label={item.data.title}>
                <a class="gallery-lightbox-close" href="#" aria-label="Close fullscreen view">×</a>
                <nav class="gallery-lightbox-nav" aria-label="Gallery navigation">
                  <a class="gallery-lightbox-nav-button gallery-lightbox-prev" href={`#gallery-lightbox-${prevId}`} aria-label="Previous image">←</a>
                  <a class="gallery-lightbox-nav-button gallery-lightbox-next" href={`#gallery-lightbox-${nextId}`} aria-label="Next image">→</a>
                </nav>
                <div class="gallery-lightbox-inner">
                  <img data-src={item.lightboxSrc} alt={imageAlt} />
                  <div class="gallery-lightbox-meta">
                    {dateMeta}
                    <h2>{item.data.title}</h2>
                    <p>{item.data.caption}</p>
                  </div>
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
  </section>
  <script type="module" src="/scripts/justified-gallery.js"></script>
  <script type="module" src="/scripts/gallery-lightbox.js"></script>
</BaseLayout>
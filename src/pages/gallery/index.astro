---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import { withBase } from '@utils/paths';
import {
  getYouTubeThumbnailFallbackUrl,
  getYouTubeThumbnailUrl,
  getYouTubeVideoId
} from '@utils/youtube';

// Tiles are sized in CSS pixels by justified-gallery.js (rows target 260px tall, or
// full container width for `layout: full`), so each derivative is a fixed width chosen
// to cover that at 2x DPR rather than a srcset the layout script can't describe.
const THUMB_WIDTH = 900;
const THUMB_WIDTH_FULL = 1800;
const LIGHTBOX_WIDTH = 2200;

// Pinned items (those with an `order`) come first, in order. Everything else sorts
// newest-first by date, with the title as a deterministic tie-break — month-only dates
// sort as the 1st of the month, so they land after that month's precisely-dated items.
const rawGallery = (await getCollection('gallery')).sort((a, b) => {
  if (a.data.order !== undefined || b.data.order !== undefined) {
    if (a.data.order === undefined) return 1;
    if (b.data.order === undefined) return -1;
    return a.data.order - b.data.order;
  }
  const byDate = (b.data.date?.value.getTime() ?? 0) - (a.data.date?.value.getTime() ?? 0);
  return byDate !== 0 ? byDate : a.data.title.localeCompare(b.data.title);
});

// Dates render at their known precision; formatters are UTC because month-only dates are
// normalised to UTC midnight and must not drift into the previous month/day.
const dayFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC'
});
const monthFormatter = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' });

const formatGalleryDate = (date: { value: Date; precision: 'day' | 'month' }) =>
  date.precision === 'day' ? dayFormatter.format(date.value) : monthFormatter.format(date.value);

const gallery = await Promise.all(
  rawGallery.map(async (item) => {
    const isFull = item.data.layout === 'full';
    const videoId = getYouTubeVideoId(item.data.videoUrl);

    if (videoId) {
      // Video item: the tile and lightbox poster come straight from YouTube (16:9). The
      // player iframe is injected only when the user clicks play (see gallery-lightbox.js),
      // so no YouTube request happens until then.
      return {
        ...item,
        isFull,
        isVideo: true as const,
        videoId,
        aspectRatio: 16 / 9,
        posterSrc: getYouTubeThumbnailUrl(item.data.videoUrl),
        posterFallback: getYouTubeThumbnailFallbackUrl(item.data.videoUrl)
      };
    }

    // Image item. Everything is derived from getImage() results rather than read off
    // item.data.image: touching a property on the original metadata makes Astro emit the
    // full-size original into dist/_astro even though nothing links to it — see
    // https://github.com/withastro/astro/issues/11887. The schema guarantees image is set
    // whenever there is no video, so the non-null assertion is safe.
    const [thumb, lightbox] = await Promise.all([
      getImage({ src: item.data.image!, width: isFull ? THUMB_WIDTH_FULL : THUMB_WIDTH, format: 'webp' }),
      getImage({ src: item.data.image!, width: LIGHTBOX_WIDTH, format: 'webp' })
    ]);

    return {
      ...item,
      isFull,
      isVideo: false as const,
      aspectRatio: Number(thumb.attributes.width) / Number(thumb.attributes.height),
      thumb,
      lightboxSrc: lightbox.src
    };
  })
);

// One shared lightbox shell (below) is populated from this data as the user opens and pages
// through items, so the frame stays mounted and only its contents crossfade. `ar` drives the
// panel's height animation between images of different aspect ratios.
const lightboxItems = gallery.map((item) => {
  const meta = item.data.dateLabel ?? (item.data.date ? formatGalleryDate(item.data.date) : null);
  const base = {
    id: item.id,
    title: item.data.title,
    meta,
    caption: item.data.caption,
    alt: item.data.imageAlt ?? (item.data.caption || item.data.title),
    ar: item.aspectRatio,
    isVideo: item.isVideo
  };
  return item.isVideo
    ? { ...base, src: null, videoId: item.videoId, posterSrc: item.posterSrc, posterFallback: item.posterFallback }
    : { ...base, src: item.lightboxSrc, videoId: null, posterSrc: null, posterFallback: null };
});
---

<BaseLayout title="Gallery" description="Gallery and logo story from the Autonomous Materials Discovery Group Cambridge.">
  <PageHeader
    title="Gallery"
    description="Photo-first moments from the lab, events, conferences, visitors, and group life."
  />
  <section class="section">
    <ul class="container gallery-grid" id="gallery-wall">
      {
        gallery.map((item) => {
          const imageAlt = item.data.imageAlt ?? (item.data.caption || item.data.title);
          const meta = item.data.dateLabel ?? (item.data.date ? formatGalleryDate(item.data.date) : null);

          return (
            <li class="gallery-card">
              <figure class="gallery-figure">
                <a
                  class="gallery-thumb-link"
                  href={`#gallery-lightbox-${item.id}`}
                  aria-label={item.isVideo ? `Play ${item.data.title} video` : `View ${item.data.title} fullscreen`}
                >
                  {item.isVideo ? (
                    <Fragment>
                      <img
                        src={item.posterSrc}
                        alt={imageAlt}
                        loading="lazy"
                        onerror={item.posterFallback ? `this.onerror=null;this.src='${item.posterFallback}'` : undefined}
                      />
                      <span class="gallery-play-badge" aria-hidden="true" />
                    </Fragment>
                  ) : (
                    <img
                      src={item.thumb.src}
                      width={item.thumb.attributes.width}
                      height={item.thumb.attributes.height}
                      alt={imageAlt}
                      loading="lazy"
                    />
                  )}
                </a>
                <figcaption>
                  {meta && <p class="meta">{meta}</p>}
                  <h2>{item.data.title}</h2>
                  {item.data.caption && <p>{item.data.caption}</p>}
                </figcaption>
              </figure>
            </li>
          );
        })
      }
    </ul>
  </section>
  {/* One shared backdrop for every lightbox: it fades with the body class (set while any
      item is open, unchanged while paging), so switching items never crossfades the wall. */}
  <div class="gallery-backdrop" aria-hidden="true"></div>

  {/* One shared lightbox shell. The script fills the stage + meta from the data island and
      keeps this frame mounted, crossfading only the contents when paging between items. */}
  <div class="gallery-lightbox" id="gallery-lightbox" role="dialog" aria-modal="true" aria-label="Gallery viewer" tabindex="-1">
    <button class="gallery-lightbox-close" type="button" aria-label="Close fullscreen view">×</button>
    <nav class="gallery-lightbox-nav" aria-label="Gallery navigation">
      <button class="gallery-lightbox-nav-button gallery-lightbox-prev" type="button" aria-label="Previous item">←</button>
      <button class="gallery-lightbox-nav-button gallery-lightbox-next" type="button" aria-label="Next item">→</button>
    </nav>
    <div class="gallery-lightbox-inner">
      <div class="gallery-lightbox-stage"></div>
      <div class="gallery-lightbox-meta"></div>
    </div>
  </div>
  <script type="application/json" id="gallery-lightbox-data" is:inline set:html={JSON.stringify(lightboxItems).replace(/</g, '\\u003c')}></script>

  <script type="module" src={withBase('/scripts/gallery-lightbox.js')}></script>
</BaseLayout>

---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import PersonCard from '@components/PersonCard.astro';
import AlumniPerson from '@components/AlumniPerson.astro';

const roleRank = (person: CollectionEntry<'people'>) => {
  const role = person.data.role.toLowerCase();
  const group = person.data.group?.toLowerCase() ?? '';
  if (role.includes('principal investigator')) return 0;
  if (role.includes('lab manager')) return 1;
  if (role.includes('postdoc') || role.includes('postdoctoral')) return 2;
  if (role.includes('phd')) return 3;
  if (role.includes('mphil') || group.includes('amet')) return 4;
  if (role.includes('intern')) return 5;
  return 6;
};

const people = await Promise.all(
  (await getCollection('people'))
    .sort((a, b) => {
      if (a.data.status !== b.data.status) return a.data.status === 'current' ? -1 : 1;
      if (a.data.status === 'current') {
        const rankDiff = roleRank(a) - roleRank(b);
        if (rankDiff !== 0) return rankDiff;
      } else {
        const orderDiff = a.data.order - b.data.order;
        if (orderDiff !== 0) return orderDiff;
      }
      return a.data.name.localeCompare(b.data.name);
    })
    .map(async (person) => ({
      person,
      Content: (await render(person)).Content
    }))
);

const currentPeople = people.filter(({ person }) => person.data.status === 'current');
const alumni = people.filter(({ person }) => person.data.status === 'alumni');
---

<BaseLayout title="People" description="Current people and alumni of the Autonomous Materials Discovery Group Cambridge.">
  <PageHeader
    title="People"
    description="Researchers, students, collaborators, and alumni shaping the lab."
  />
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Current</h2>
        </div>
      </div>
      <div class="grid four">
        {
          currentPeople.map(({ person, Content }) => (
            <PersonCard person={person}>
              <Content />
            </PersonCard>
          ))
        }
      </div>
    </div>
  </section>
  {
    alumni.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <div>
              <h2>Alumni</h2>
            </div>
          </div>
          <div class="alumni-list">
            {alumni.map(({ person }) => (
              <AlumniPerson person={person} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

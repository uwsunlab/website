---
import BaseLayout from '@layouts/BaseLayout.astro';
import { withBase } from '@utils/paths';

const mediaPath = withBase('/media/');
---

<BaseLayout title="Media">
  <section class="section">
    <div class="container narrow">
      <h1>News archive has moved to Media</h1>
      <p>
        The full news archive now lives on
        {' '}<a href={mediaPath}>the Media page</a>.
      </p>
    </div>
  </section>
  <script is:inline define:vars={{ mediaPath }}>
    window.location.replace(mediaPath);
  </script>
</BaseLayout>

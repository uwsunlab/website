---
import BaseLayout from '@layouts/BaseLayout.astro';
import { withBase } from '@utils/paths';

const talksEventsPath = withBase('/talks-events/');
---

<BaseLayout title="Talks & Events">
  <section class="section">
    <div class="container narrow">
      <h1>Talks & Events</h1>
      <p>
        Talks, videos, and event listings now live on
        {' '}<a href={talksEventsPath}>the Talks & Events page</a>.
      </p>
    </div>
  </section>
  <script is:inline define:vars={{ talksEventsPath }}>
    window.location.replace(talksEventsPath);
  </script>
</BaseLayout>

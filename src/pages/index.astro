---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import { externalLinkAttrs } from '@utils/links';
import { withBase } from '@utils/paths';

const homeEntries = await getCollection('home');
const overview = homeEntries.find((entry) => entry.id === 'overview');
if (!overview) {
  throw new Error('Missing home overview content at src/content/home/overview.md');
}

const { Content: OverviewContent } = await render(overview);
const news = await getCollection('news');

const latestNews = await Promise.all(news
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 10)
  .map(async (item) => {
    const { Content } = await render(item);
    return { ...item, Content };
  }));

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC'
});
---

<BaseLayout title="Autonomous Materials Discovery Group Cambridge">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-draw" aria-hidden="true">
      <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice">
        <path class="draw-path draw-path-a" d="M-120 580 C 190 300, 420 720, 730 420 S 1230 210, 1740 470" />
        <path class="draw-path draw-path-b" d="M-80 345 C 270 520, 420 170, 760 330 S 1220 680, 1680 250" />
        <path class="draw-path draw-path-c" d="M120 930 C 270 520, 560 680, 760 390 S 1140 130, 1510 -60" />
        <path class="draw-path draw-path-d" d="M-180 720 C 170 640, 320 160, 650 250 S 1030 610, 1780 650" />
        <path class="draw-path draw-path-e" d="M250 -120 C 360 220, 620 240, 760 450 S 1080 690, 1380 1020" />
        <circle class="draw-node draw-node-a" cx="730" cy="420" r="5" />
        <circle class="draw-node draw-node-b" cx="760" cy="330" r="5" />
        <circle class="draw-node draw-node-c" cx="760" cy="450" r="5" />
      </svg>
    </div>
    <div class="container home-hero-inner">
      <h1 id="home-title">Programmable Assembly of Functional Materials</h1>
      <div class="home-actions" aria-label="Home page actions">
        <a class="button" href={withBase('/research/')}>Our Research</a>
        <a class="button button-secondary" href={withBase('/join-us/')}>Open Positions</a>
      </div>
    </div>
  </section>

  <section class="home-panel section" aria-label="Group overview">
    <div class="container home-overview">
      <figure class="home-overview-media">
        <Image
          src={overview.data.image}
          widths={[700, 1300]}
          sizes="(max-width: 900px) 100vw, 650px"
          format="webp"
          alt={overview.data.imageAlt}
          loading="lazy"
        />
      </figure>
      <div class="home-overview-copy">
        <OverviewContent />
      </div>
    </div>
  </section>

  <section class="home-news section alt" aria-labelledby="news-title">
    <div class="container news-section">
      <h2 id="news-title">News</h2>
      <ol class="news-list">
        {
          latestNews.map((item) => (
            <li class="news-item">
              <time datetime={item.data.date.toISOString()}>{dateFormatter.format(item.data.date)}</time>
              <div class="news-copy">
                <item.Content />
              </div>
              {item.data.image && (
                <a
                  class="news-thumb"
                  href={item.data.relatedUrl ?? withBase('/gallery/')}
                  {...externalLinkAttrs(item.data.relatedUrl)}
                >
                  <img src={item.data.image} alt={item.data.imageAlt ?? 'News image'} loading="lazy" />
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '@layouts/BaseLayout.astro';
import { withBase } from '@utils/paths';

const activitiesPath = withBase('/activities/');
---

<BaseLayout title="Activities">
  <section class="section">
    <div class="container narrow">
      <h1>Media has moved to Activities</h1>
      <p>
        Talks, videos, and event listings now live on
        {' '}<a href={activitiesPath}>the Activities page</a>.
      </p>
    </div>
  </section>
  <script is:inline define:vars={{ activitiesPath }}>
    window.location.replace(activitiesPath);
  </script>
</BaseLayout>

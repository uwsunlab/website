---
import BaseLayout from '@layouts/BaseLayout.astro';
import { withBase } from '@utils/paths';

const newsPath = withBase('/news/');
---

<BaseLayout title="Media">
  <section class="section">
    <div class="container narrow">
      <h1>Media has moved to News</h1>
      <p>
        The media, coverage, talks, events, and lab updates archive now lives on
        {' '}<a href={newsPath}>the News page</a>.
      </p>
    </div>
  </section>
  <script is:inline define:vars={{ newsPath }}>
    window.location.replace(newsPath);
  </script>
</BaseLayout>

---
import type { CollectionEntry } from 'astro:content';
import { getYouTubeThumbnailUrl } from '@utils/youtube';

interface Props {
  media: CollectionEntry<'media'>[];
}

const { media } = Astro.props;
---

<div class="post-list">
  {
    media.map((item) => {
      const thumbSrc = item.data.image ?? getYouTubeThumbnailUrl(item.data.externalUrl);
      const thumbAlt = item.data.imageAlt ?? `${item.data.title} media image`;

      return (
        <article class="post-item media-card">
          <div class={`media-thumb ${thumbSrc ? 'has-image' : ''}`}>
            {thumbSrc ? (
              item.data.externalUrl ? (
                <a class="media-thumb-link" href={item.data.externalUrl}>
                  <img src={thumbSrc} alt={thumbAlt} loading="lazy" />
                </a>
              ) : (
                <img src={thumbSrc} alt={thumbAlt} loading="lazy" />
              )
            ) : (
              <span>{item.data.source ?? item.data.category}</span>
            )}
          </div>
          <div class="media-copy">
            <p class="post-title">{item.data.title}</p>
            <p class="meta">
              {item.data.date.toLocaleDateString('en-GB', {
                day: 'numeric',
                month: 'long',
                year: 'numeric'
              })}
              {item.data.source ? ` · ${item.data.source}` : ''} · {item.data.category}
            </p>
            <p>{item.data.summary}</p>
            {item.data.externalUrl && <a class="text-link" href={item.data.externalUrl}>Read article</a>}
          </div>
        </article>
      );
    })
  }
</div>

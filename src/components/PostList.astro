---
import type { CollectionEntry } from 'astro:content';

interface Props {
  media: CollectionEntry<'media'>[];
}

const { media } = Astro.props;
---

<div class="post-list">
  {
    media.map((item) => (
      <article class="post-item media-card">
        <div class={`media-thumb ${item.data.image ? 'has-image' : ''}`}>
          {
            item.data.image ? (
              <img src={item.data.image} alt={item.data.imageAlt ?? `${item.data.title} media image`} loading="lazy" />
            ) : (
              <span>{item.data.source ?? item.data.category}</span>
            )
          }
        </div>
        <div class="media-copy">
          <p class="post-title">{item.data.title}</p>
          <p class="meta">
            {item.data.date.toLocaleDateString('en-GB', {
              day: 'numeric',
              month: 'long',
              year: 'numeric'
            })}
            {item.data.source ? ` · ${item.data.source}` : ''} · {item.data.category}
          </p>
          <p>{item.data.summary}</p>
          {item.data.externalUrl && <a class="text-link" href={item.data.externalUrl}>Read article</a>}
        </div>
      </article>
    ))
  }
</div>

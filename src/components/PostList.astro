---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { externalLinkAttrs } from '@utils/links';
import { getYouTubeThumbnailFallbackUrl, getYouTubeThumbnailUrl } from '@utils/youtube';

interface Props {
  media: CollectionEntry<'media'>[];
}

const { media } = Astro.props;

// Thumb column is minmax(180px, 0.34fr); ~380px at the widest, so 760 covers 2x DPR.
const THUMB_WIDTH = 760;
---

<div class="post-list">
  {
    media.map((item) => {
      // A local asset is optimised through the pipeline; otherwise fall back to a remote
      // YouTube thumbnail (a plain URL string that can't go through <Image>).
      const localImage = item.data.image;
      const ytThumb = localImage ? null : getYouTubeThumbnailUrl(item.data.externalUrl);
      const ytFallback = localImage ? null : getYouTubeThumbnailFallbackUrl(item.data.externalUrl);
      const hasThumb = Boolean(localImage || ytThumb);
      const thumbAlt = item.data.imageAlt ?? `${item.data.title} media image`;
      const thumbInner = localImage ? (
        <Image src={localImage} width={THUMB_WIDTH} format="webp" alt={thumbAlt} loading="lazy" />
      ) : ytThumb ? (
        <img
          src={ytThumb}
          alt={thumbAlt}
          loading="lazy"
          onerror={ytFallback ? `this.onerror=null;this.src='${ytFallback}'` : undefined}
        />
      ) : (
        <span>{item.data.source ?? item.data.category}</span>
      );

      return (
        <article class={`post-item media-card${hasThumb ? '' : ' no-media-thumb'}`}>
          {hasThumb && (
            <div class="media-thumb has-image">
              {item.data.externalUrl ? (
                <a
                  class="media-thumb-link"
                  href={item.data.externalUrl}
                  aria-label={item.data.title}
                  {...externalLinkAttrs(item.data.externalUrl)}
                >
                  {thumbInner}
                </a>
              ) : (
                thumbInner
              )}
            </div>
          )}
          <div class="media-copy">
            <p class="post-title">
              {item.data.externalUrl ? (
                <a
                  class="post-title-link"
                  href={item.data.externalUrl}
                  {...externalLinkAttrs(item.data.externalUrl)}
                >
                  {item.data.title}
                </a>
              ) : (
                item.data.title
              )}
            </p>
            <p class="meta">
              {item.data.date.toLocaleDateString('en-GB', {
                day: 'numeric',
                month: 'long',
                year: 'numeric'
              })}
              {item.data.source ? ` · ${item.data.source}` : ''} · {item.data.category}
            </p>
            {/* Summaries are intentionally not rendered here; kept in the .md files for later use. */}
          </div>
        </article>
      );
    })
  }
</div>

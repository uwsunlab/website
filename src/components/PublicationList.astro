---
import type { CollectionEntry } from 'astro:content';
import { externalLinkAttrs } from '@utils/links';

interface Props {
  papers: CollectionEntry<'papers'>[];
}

const { papers } = Astro.props;
---

<div class="publication-list">
  {
    papers.map((paper) => (
      <article class="publication-item">
        {
          paper.data.image && (
            <img
              class="paper-thumb"
              src={paper.data.image}
              alt={paper.data.imageAlt ?? `${paper.data.title} paper image`}
              loading="lazy"
            />
          )
        }
        <p class="publication-title">{paper.data.title}</p>
        <p class="meta">
          {paper.data.authors}. {paper.data.venue}, {paper.data.year}.
        </p>
        {paper.data.summary && <p>{paper.data.summary}</p>}
        <div class="button-row">
          {paper.data.url && (
            <a class="text-link" href={paper.data.url} {...externalLinkAttrs(paper.data.url)}>
              Article
            </a>
          )}
          {paper.data.doi && <span class="meta">DOI: {paper.data.doi}</span>}
          {paper.data.pdf && (
            <a class="text-link" href={paper.data.pdf} {...externalLinkAttrs(paper.data.pdf)}>
              PDF
            </a>
          )}
        </div>
      </article>
    ))
  }
</div>

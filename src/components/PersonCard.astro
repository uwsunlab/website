---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { externalLinkAttrs } from '@utils/links';

interface Props {
  person: CollectionEntry<'people'>;
}

const { person } = Astro.props;
const photo = person.data.photo;
const initials = person.data.name
  .split(' ')
  .map((part) => part[0])
  .join('')
  .slice(0, 2);
const dialogId = `person-dialog-${person.data.name.replace(/[^\w-]+/g, '-')}`;
const affiliations = person.data.affiliation
  ? Array.isArray(person.data.affiliation)
    ? person.data.affiliation
    : [person.data.affiliation]
  : [];
---

<article class="person-card" tabindex="0" role="button" aria-haspopup="dialog" aria-controls={dialogId}>
  <div class="person-card-face">
    {
      typeof photo === 'object' ? (
        <Image
          class="person-photo"
          src={photo}
          width={600}
          format="webp"
          alt={`Portrait of ${person.data.name}`}
          loading="lazy"
        />
      ) : photo ? (
        <img class="person-photo" src={photo} alt={`Portrait of ${person.data.name}`} loading="lazy" />
      ) : (
        <div class="person-photo" aria-hidden="true">{initials}</div>
      )
    }
    <div class="content">
      <h2>{person.data.name}</h2>
      <p class="meta">{person.data.role}</p>
      {affiliations.map((affiliation) => <p class="meta">{affiliation}</p>)}
      {
        person.data.links.length > 0 && (
          <div class="person-links">
            {person.data.links.map((link) => (
              <a href={link.url} {...externalLinkAttrs(link.url)}>
                {link.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</article>

<dialog class="person-dialog" id={dialogId} aria-labelledby={`${dialogId}-title`}>
  <div class="person-dialog-inner">
    <button class="person-dialog-close" type="button" aria-label={`Close ${person.data.name} bio`}>Close</button>
    <div class="person-dialog-header">
      {
        typeof photo === 'object' ? (
          <Image
            class="person-dialog-photo"
            src={photo}
            width={360}
            format="webp"
            alt={`Portrait of ${person.data.name}`}
            loading="lazy"
          />
        ) : photo ? (
          <img class="person-dialog-photo" src={photo} alt={`Portrait of ${person.data.name}`} loading="lazy" />
        ) : (
          <div class="person-dialog-photo" aria-hidden="true">{initials}</div>
        )
      }
      <div>
        <h2 id={`${dialogId}-title`}>{person.data.name}</h2>
        <p class="meta">{person.data.role}</p>
        {affiliations.map((affiliation) => <p class="meta">{affiliation}</p>)}
      </div>
    </div>
    <div class="person-dialog-bio">
      <slot />
    </div>
  </div>
</dialog>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  // Must outlast the CSS exit transition (--dur-slow); only used if transitionend is missed.
  const EXIT_FALLBACK_MS = 400;

  /**
   * Fades the dialog out before closing it. `dialog.close()` would drop it out of the top
   * layer immediately and kill the animation, so the class drives the transition and the
   * close is held back until it finishes.
   */
  function requestClose(dialog: HTMLDialogElement) {
    if (dialog.dataset.closing) return;

    if (reduceMotion.matches) {
      dialog.close();
      return;
    }

    dialog.dataset.closing = 'true';
    dialog.classList.add('is-closing');

    let timer = 0;
    const finish = () => {
      window.clearTimeout(timer);
      dialog.removeEventListener('transitionend', onEnd);
      dialog.classList.remove('is-closing');
      delete dialog.dataset.closing;
      dialog.close();
    };
    // Both opacity and transform transition; settle on the one that always runs.
    const onEnd = (event: TransitionEvent) => {
      if (event.target === dialog && event.propertyName === 'opacity') finish();
    };

    dialog.addEventListener('transitionend', onEnd);
    // Safety net for engines that skip the transition, or a tab backgrounded mid-fade.
    timer = window.setTimeout(finish, EXIT_FALLBACK_MS);
  }

  function init() {
    document.querySelectorAll<HTMLElement>('.person-card').forEach((card) => {
      const dialogId = card.getAttribute('aria-controls');
      const dialog = dialogId ? document.getElementById(dialogId) as HTMLDialogElement | null : null;
      if (!dialog) return;
      const close = dialog.querySelector<HTMLButtonElement>('.person-dialog-close');
      const open = () => {
        if (dialog.open) return;
        dialog.showModal();
      };

      card.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target.closest('a')) return;
        open();
      });

      card.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        const target = event.target as HTMLElement;
        if (target.closest('a')) return;
        event.preventDefault();
        open();
      });

      close?.addEventListener('click', () => requestClose(dialog));

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) requestClose(dialog);
      });

      // Esc fires `cancel` and would close instantly; route it through the fade instead.
      dialog.addEventListener('cancel', (event) => {
        if (dialog.dataset.closing) return;
        event.preventDefault();
        requestClose(dialog);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => requestAnimationFrame(init));
  } else {
    requestAnimationFrame(init);
  }
</script>

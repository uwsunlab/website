---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { externalLinkAttrs } from '@utils/links';

interface Props {
  person: CollectionEntry<'people'>;
}

const { person } = Astro.props;
const photo = person.data.photo;
const initials = person.data.name
  .split(' ')
  .map((part) => part[0])
  .join('')
  .slice(0, 2);
---

<article class="person-card">
  {
    typeof photo === 'object' ? (
      <Image
        class="person-photo"
        src={photo}
        width={600}
        format="webp"
        alt={`Portrait of ${person.data.name}`}
        loading="lazy"
      />
    ) : photo ? (
      <img class="person-photo" src={photo} alt={`Portrait of ${person.data.name}`} loading="lazy" />
    ) : (
      <div class="person-photo" aria-hidden="true">{initials}</div>
    )
  }
  <div class="content">
    <h2>{person.data.name}</h2>
    <p class="meta">{person.data.role}</p>
    {person.data.affiliation && <p class="meta">{person.data.affiliation}</p>}
    {
      person.data.links.length > 0 && (
        <div class="person-links">
          {person.data.links.map((link) => (
            <a href={link.url} {...externalLinkAttrs(link.url)}>
              {link.label}
            </a>
          ))}
        </div>
      )
    }
    <input
      class="person-summary-checkbox"
      type="checkbox"
      id={`person-summary-${person.data.name.replace(/[^\w-]+/g, '-')}`}
    />
    <div class="person-summary">
      <slot />
    </div>
    <label class="person-summary-toggle" for={`person-summary-${person.data.name.replace(/[^\w-]+/g, '-')}`}>
      <span class="summary-open">read bio<span class="toggle-icon" aria-hidden="true">▾</span></span>
      <span class="summary-close">hide bio<span class="toggle-icon" aria-hidden="true">▴</span></span>
    </label>
  </div>
</article>

<script>
  import {
    EASE_SLIDE,
    HEIGHT_CLOSE,
    HEIGHT_OPEN,
    animateHeight,
    animateIn,
    animateOut,
    reduceMotion,
    resetWords,
    wrapWords
  } from '@scripts/word-reveal';

  const FOLD_EPS = 2;

  // Marks JS as active so the CSS keeps the summary clamped while checked.
  document.documentElement.classList.add('js-reveal');

  // Words whose top sits at or below the clamped fold are the newly revealed
  // ones. Must be measured while the summary is still clamped.
  function findNewWords(summary: HTMLElement): HTMLElement[] {
    const foldBottom = summary.getBoundingClientRect().top + summary.clientHeight;
    const out: HTMLElement[] = [];
    summary.querySelectorAll<HTMLElement>('.reveal-word').forEach((w) => {
      if (w.getBoundingClientRect().top >= foldBottom - FOLD_EPS) out.push(w);
    });
    return out;
  }

  // Settles into the fully expanded state: natural height. overflow stays
  // hidden so the summary keeps its block formatting context — otherwise the
  // bio's top margin would collapse out and nudge the text upward. With height
  // auto nothing is actually clipped.
  function finalizeExpanded(summary: HTMLElement) {
    summary.getAnimations().forEach((a) => a.cancel());
    summary.style.height = '';
    summary.style.overflow = 'hidden';
  }

  // Returns the summary to the CSS-driven clamped (-webkit-box) state.
  function restoreCollapsed(summary: HTMLElement) {
    summary.getAnimations().forEach((a) => a.cancel());
    summary.style.height = '';
    summary.style.overflow = '';
    summary.style.display = '';
    summary.style.removeProperty('-webkit-line-clamp');
  }

  function init() {
    document.querySelectorAll<HTMLElement>('.person-card').forEach((card) => {
      const summary = card.querySelector<HTMLElement>('.person-summary');
      const toggle = card.querySelector<HTMLElement>('.person-summary-toggle');
      const checkbox = card.querySelector<HTMLInputElement>('.person-summary-checkbox');
      if (!summary || !toggle || !checkbox) return;

      // Hide the control when the bio already fits within the clamp.
      if (summary.scrollHeight <= summary.clientHeight + 1) {
        toggle.style.display = 'none';
        checkbox.style.display = 'none';
        return;
      }

      let newWords: HTMLElement[] = [];
      let collapsedH = 0; // clamped height, remembered for the closing slide

      card.tabIndex = 0;
      card.setAttribute('aria-expanded', String(checkbox.checked));

      checkbox.addEventListener('change', () => {
        card.setAttribute('aria-expanded', String(checkbox.checked));
        if (checkbox.checked) {
          wrapWords(summary);
          newWords = findNewWords(summary); // measured while still clamped
          collapsedH = summary.getBoundingClientRect().height;

          // Switch to a plain block so the height slide clips cleanly, then
          // measure the natural expanded height to animate toward.
          summary.getAnimations().forEach((a) => a.cancel());
          summary.style.display = 'block';
          summary.style.overflow = 'hidden';
          summary.style.height = 'auto';
          const expandedH = summary.getBoundingClientRect().height;

          if (reduceMotion.matches || newWords.length === 0) {
            finalizeExpanded(summary);
            resetWords(newWords);
            return;
          }
          animateIn(newWords);
          animateHeight(summary, collapsedH, expandedH, HEIGHT_OPEN, EASE_SLIDE, () =>
            finalizeExpanded(summary)
          );
        } else {
          const currentH = summary.getBoundingClientRect().height;
          summary.getAnimations().forEach((a) => a.cancel());
          summary.style.display = 'block';
          summary.style.overflow = 'hidden';
          summary.style.height = `${currentH}px`;

          if (reduceMotion.matches || newWords.length === 0 || !collapsedH) {
            resetWords(newWords);
            restoreCollapsed(summary);
            return;
          }
          animateOut(newWords, () => {});
          animateHeight(summary, currentH, collapsedH, HEIGHT_CLOSE, EASE_SLIDE, () => {
            resetWords(newWords);
            restoreCollapsed(summary);
          });
        }
      });

      card.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target.closest('a, button, input, label')) return;
        checkbox.checked = !checkbox.checked;
        checkbox.dispatchEvent(new Event('change', { bubbles: true }));
      });

      card.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        const target = event.target as HTMLElement;
        if (target.closest('a, button, input, label')) return;
        event.preventDefault();
        checkbox.checked = !checkbox.checked;
        checkbox.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => requestAnimationFrame(init));
  } else {
    requestAnimationFrame(init);
  }
</script>

---
import type { CollectionEntry } from 'astro:content';
import { externalLinkAttrs } from '@utils/links';

interface Props {
  person: CollectionEntry<'people'>;
}

const { person } = Astro.props;
const initials = person.data.name
  .split(' ')
  .map((part) => part[0])
  .join('')
  .slice(0, 2);
---

<article class="person-card">
  {
    person.data.photo ? (
      <img class="person-photo" src={person.data.photo} alt={`Portrait of ${person.data.name}`} loading="lazy" />
    ) : (
      <div class="person-photo" aria-hidden="true">{initials}</div>
    )
  }
  <div class="content">
    <h2>{person.data.name}</h2>
    <p class="meta">{person.data.role}</p>
    {person.data.affiliation && <p class="meta">{person.data.affiliation}</p>}
    {
      person.data.links.length > 0 && (
        <div class="person-links">
          {person.data.links.map((link) => (
            <a href={link.url} {...externalLinkAttrs(link.url)}>
              {link.label}
            </a>
          ))}
        </div>
      )
    }
    <input
      class="person-summary-checkbox"
      type="checkbox"
      id={`person-summary-${person.data.name.replace(/[^\w-]+/g, '-')}`}
    />
    <div class="person-summary">
      <slot />
    </div>
    <label class="person-summary-toggle" for={`person-summary-${person.data.name.replace(/[^\w-]+/g, '-')}`}>
      <span class="summary-open">see more</span>
      <span class="summary-close">see less</span>
    </label>    
  </div>
</article>

<script type="module">
  if (!window.__personSummaryToggleInit) {
    window.__personSummaryToggleInit = true;
    document.addEventListener('DOMContentLoaded', () => {
      requestAnimationFrame(() => {
        document.querySelectorAll('.person-card').forEach((card) => {
          const summary = card.querySelector('.person-summary');
          const toggle = card.querySelector('.person-summary-toggle');
          const checkbox = card.querySelector('.person-summary-checkbox');
          if (!summary || !toggle || !checkbox) return;
          if (summary.scrollHeight <= summary.clientHeight + 1) {
            toggle.style.display = 'none';
            checkbox.style.display = 'none';
          }
        });
      });
    });
  }
</script>

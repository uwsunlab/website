---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { externalLinkAttrs } from '@utils/links';

interface Props {
  person: CollectionEntry<'people'>;
}

const { person } = Astro.props;
const photo = person.data.photo;
const initials = person.data.name
  .split(' ')
  .map((part) => part[0])
  .join('')
  .slice(0, 2);
const dialogId = `person-dialog-${person.data.name.replace(/[^\w-]+/g, '-')}`;
const affiliations = person.data.affiliation
  ? Array.isArray(person.data.affiliation)
    ? person.data.affiliation
    : [person.data.affiliation]
  : [];
---

<article class="person-card" tabindex="0" role="button" aria-haspopup="dialog" aria-controls={dialogId}>
  <div class="person-card-face">
    {
      typeof photo === 'object' ? (
        <Image
          class="person-photo"
          src={photo}
          width={600}
          format="webp"
          alt={`Portrait of ${person.data.name}`}
          loading="lazy"
        />
      ) : photo ? (
        <img class="person-photo" src={photo} alt={`Portrait of ${person.data.name}`} loading="lazy" />
      ) : (
        <div class="person-photo" aria-hidden="true">{initials}</div>
      )
    }
    <div class="content">
      <h2>{person.data.name}</h2>
      <p class="meta">{person.data.role}</p>
      {affiliations.map((affiliation) => <p class="meta">{affiliation}</p>)}
      {
        person.data.links.length > 0 && (
          <div class="person-links">
            {person.data.links.map((link) => (
              <a href={link.url} {...externalLinkAttrs(link.url)}>
                {link.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</article>

<dialog class="person-dialog" id={dialogId} aria-labelledby={`${dialogId}-title`}>
  <div class="person-dialog-inner">
    <button class="person-dialog-close" type="button" aria-label={`Close ${person.data.name} bio`}>Close</button>
    <div class="person-dialog-header">
      {
        typeof photo === 'object' ? (
          <Image
            class="person-dialog-photo"
            src={photo}
            width={360}
            format="webp"
            alt={`Portrait of ${person.data.name}`}
            loading="lazy"
          />
        ) : photo ? (
          <img class="person-dialog-photo" src={photo} alt={`Portrait of ${person.data.name}`} loading="lazy" />
        ) : (
          <div class="person-dialog-photo" aria-hidden="true">{initials}</div>
        )
      }
      <div>
        <h2 id={`${dialogId}-title`}>{person.data.name}</h2>
        <p class="meta">{person.data.role}</p>
        {affiliations.map((affiliation) => <p class="meta">{affiliation}</p>)}
      </div>
    </div>
    <div class="person-dialog-bio">
      <slot />
    </div>
  </div>
</dialog>

<script>
  function init() {
    document.querySelectorAll<HTMLElement>('.person-card').forEach((card) => {
      const dialogId = card.getAttribute('aria-controls');
      const dialog = dialogId ? document.getElementById(dialogId) as HTMLDialogElement | null : null;
      if (!dialog) return;
      const close = dialog.querySelector<HTMLButtonElement>('.person-dialog-close');
      const open = () => dialog.showModal();

      card.addEventListener('click', (event) => {
        const target = event.target as HTMLElement;
        if (target.closest('a')) return;
        open();
      });

      card.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        const target = event.target as HTMLElement;
        if (target.closest('a')) return;
        event.preventDefault();
        open();
      });

      close?.addEventListener('click', () => dialog.close());

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => requestAnimationFrame(init));
  } else {
    requestAnimationFrame(init);
  }
</script>

---
import type { CollectionEntry } from 'astro:content';

interface Props {
  person: CollectionEntry<'people'>;
}

const { person } = Astro.props;
const initials = person.data.name
  .split(' ')
  .map((part) => part[0])
  .join('')
  .slice(0, 2);
---

<article class="person-card">
  {
    person.data.photo ? (
      <img class="person-photo" src={person.data.photo} alt={`Portrait of ${person.data.name}`} loading="lazy" />
    ) : (
      <div class="person-photo" aria-hidden="true">{initials}</div>
    )
  }
  <div class="content">
    <h3>{person.data.name}</h3>
    <p class="meta">{person.data.role}</p>
    {person.data.affiliation && <p class="meta">{person.data.affiliation}</p>}
    <slot />
    {
      person.data.links.length > 0 && (
        <div class="person-links">
          {person.data.links.map((link) => <a href={link.url}>{link.label}</a>)}
        </div>
      )
    }
  </div>
</article>

---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  item: CollectionEntry<'researchProjects'>;
}

const { item } = Astro.props;
const imageAlt = item.data.imageAlt ?? `${item.data.title} research image`;
const image = item.data.image;
---

<article class="research-item">
  {
    typeof image === 'object' ? (
      <Image src={image} width={800} format="webp" alt={imageAlt} loading="lazy" />
    ) : (
      image && <img src={image} alt={imageAlt} loading="lazy" />
    )
  }
  <h3>{item.data.title}</h3>
  {item.data.subtitle && <p class="publication-title">{item.data.subtitle}</p>}
  <p>{item.data.summary}</p>
</article>

---
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import '@styles/global.css';
import { withBase } from '@utils/paths';
// Imported for its hashed URL so the roman latin cut can be preloaded. It is the only font
// file every page needs; the italic and latin-ext cuts are left to load on demand.
import openSansLatin from '@assets/fonts/open-sans-latin.woff2?url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Autonomous Materials Discovery Group Cambridge',
  description = 'Autonomous materials discovery research, people, publications, news, gallery, and contact information from the Autonomous Materials Discovery Group Cambridge.'
} = Astro.props;

const siteTitle = 'Autonomous Materials Discovery Group Cambridge';
const pageTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase('/favicon.svg')} />
    {/* crossorigin is required even same-origin — fonts fetch in CORS mode, and without it
        the preload is discarded and the file fetched twice. */}
    <link rel="preload" href={openSansLatin} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <script is:inline>
      // A navigation that lands while a page transition is still running makes the browser
      // abort it, which flashes white for a frame or two. `pagereveal` fires in the incoming
      // document before its first render, so links can be held inert until it settles.
      // Browsers without cross-document view transitions never fire it and are unaffected.
      addEventListener('pagereveal', (event) => {
        if (!event.viewTransition) return;
        const root = document.documentElement;
        const clear = () => root.classList.remove('is-transitioning');
        root.classList.add('is-transitioning');
        event.viewTransition.finished.then(clear, clear);
        // Insurance: never leave the site unclickable if that promise does not settle.
        setTimeout(clear, 400);
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <Header />
      <main id="main" class="site-main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
